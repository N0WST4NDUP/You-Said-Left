root = true

# Unity-serialized assets deliberately have no formatting section.
[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = true:suggestion
csharp_style_namespace_declarations = block_scoped:suggestion
dotnet_sort_system_directives_first = true

# Suggestions in supporting IDEs, not compiler or CI gates.
dotnet_naming_rule.private_fields_use_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_use_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_use_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Explicit private-constant intersection avoids overlapping naming rules.
dotnet_naming_rule.private_constants_use_pascal_case.symbols = private_constant_fields
dotnet_naming_rule.private_constants_use_pascal_case.style = pascal_case
dotnet_naming_rule.private_constants_use_pascal_case.severity = suggestion
dotnet_naming_symbols.private_constant_fields.applicable_kinds = field
dotnet_naming_symbols.private_constant_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_constant_fields.required_modifiers = const

# Constants at other accessibilities also use PascalCase.
dotnet_naming_rule.constants_use_pascal_case.symbols = constant_fields
dotnet_naming_rule.constants_use_pascal_case.style = pascal_case
dotnet_naming_rule.constants_use_pascal_case.severity = suggestion
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.pascal_case.capitalization = pascal_case

[{*.json,*.asmdef,*.asmref,*.inputactions}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false
indent_style = space
indent_size = 4

[{.editorconfig,.gitattributes,.gitignore,.gitmessage}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
